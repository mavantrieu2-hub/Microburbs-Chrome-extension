{
    "manifest_version": 3,
    "name": "Microburbs Smart Buyer Sidebar",
    "version": "1.0",
    "description": "Shows the AVM valuation and local amenities beside the listing on Australian property websites.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://*.domain.com.au/*",
        "https://*.realestate.com.au/*",
        "https://api.microburbs.com.au/*",
        "https://routing.openstreetmap.de/*",
        "https://*.tile.openstreetmap.org/*"
    ],
    "web_accessible_resources": [
        {
            "resources": ["map.html", "map.js", "lib/leaflet.js", "lib/leaflet.css"],
            "matches": [
                "https://*.domain.com.au/*",
                "https://*.realestate.com.au/*"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.domain.com.au/*",
                "https://*.realestate.com.au/*"
            ],
            "js": ["content.js"],
            "css": ["styles.css"]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Microburbs Buyer Assistant"
    }
}
